# =================================================================
# Procucev AI Real-time Transcription Service - Environment Template
# =================================================================
# Copy this file to '.env' and fill in the values for your deployment.

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Optional: Google Gemini Multimodal API Key (for server-side fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration (when running with 'postgres' profile)
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=transcription_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_in_production

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://*.lhr.life,https://*.onrender.com

# Logging Level (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SQL=WARN
